# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg

# ── uv ────────────────────────────────────────────────────────────────────
.venv/
.uv/

# ── JUPYTER — PERMANENTLY BLOCKED (migrated to marimo) ─────────────────────
# Jupyter notebooks are OBSOLETE in this repo.
# All interactive analysis lives in marimo .py files.
# Any .ipynb committed here is an error.
*.ipynb
.ipynb_checkpoints/
**/.ipynb_checkpoints/
*.jupyter/
.jupyter/
jupyter_notebook_config.py

# ── Marimo ────────────────────────────────────────────────────────────────────
# Marimo cache (auto-generated, not source code)
.marimo/
__marimo__/

# ── Data (never commit raw data) ────────────────────────────────────────────
*/data/*.csv
*/data/*.xlsx
*/data/*.xls
*/data/*.parquet
*/data/*.json
*/data/*.zip
!*/data/download.sh
!*/data/.gitkeep

# ── Reports (generated artifacts, not source) ───────────────────────────
*/reports/*.html
*/reports/*.pdf
*/reports/*.png
!*/reports/.gitkeep

# ── Models (serialized, not source) ───────────────────────────────────
*.pkl
*.joblib
*.h5
*.onnx
models/
*/models/

# ── Environment ───────────────────────────────────────────────────────────────
.env
.env.local
*.env

# ── OS ─────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*~

# ── IDE ─────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.iml
