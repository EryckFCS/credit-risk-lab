   "source": [
    "# Case Study 01 — Final Report Export\n",
    "\n",
    "**Erick Condoy** · Economist (UNL) · Quant Researcher  \n",
    "Repository: [credit-risk-lab](https://github.com/EryckFCS/credit-risk-lab)\n",
    "\n",
    "---\n",
    "\n",
    "This notebook: collects all artefacts → builds a self-contained HTML report → generates LinkedIn post copy.\n",
    "\n",
    "| Section | Content |\n",
    "|---------|---------|\n",
    "| 1 | Load All Artefacts & Metrics |\n",
    "| 2 | Build HTML Report (standalone) |\n",
    "| 3 | Export via nbconvert (CLI instructions) |\n",
    "| 4 | LinkedIn Post Generator |\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import json, base64, datetime\n",
    "from pathlib import Path\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "ARTEFACTS = Path('../artefacts')\n",
    "REPORTS   = Path('../reports')\n",
    "REPORTS.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "# Load model card\n",
    "with open(ARTEFACTS / 'model_card.json') as f:\n",
    "    card = json.load(f)\n",
    "\n",
    "# Load comparison table\n",
    "comp = pd.read_csv(ARTEFACTS / 'model_comparison.csv', index_col=0)\n",
    "\n",
    "# Load champion decision\n",
    "with open(ARTEFACTS / 'champion_decision.json') as f:\n",
    "    champ = json.load(f)\n",
    "\n",
    "perf = card['performance']\n",
    "sc   = card['scorecard_params']\n",
    "print('Artefacts loaded.')\n",
    "print(json.dumps(perf, indent=2))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 2. Build Standalone HTML Report"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def img_to_b64(path: Path) -> str:\n",
    "    \"\"\"Embed image as base64 data URI so the HTML is fully self-contained.\"\"\"\n",
    "    if not path.exists():\n",
    "        return ''\n",
    "    with open(path, 'rb') as f:\n",
    "        return 'data:image/png;base64,' + base64.b64encode(f.read()).decode()\n",
    "\n",
    "\n",
    "def metric_badge(label, value, good_thresh, lower_better=False):\n",
    "    ok = value <= good_thresh if lower_better else value >= good_thresh\n",
    "    color = '#437a22' if ok else '#964219'\n",
    "    bg    = '#d4dfcc' if ok else '#ddcfc6'\n",
    "    return (\n",
    "        f'<div style=\"display:inline-block;margin:6px;padding:10px 18px;'\n",
    "        f'background:{bg};border-radius:8px;text-align:center;\">'\
",
    "        f'<div style=\"font-size:11px;color:#7a7974;letter-spacing:.5px\">{label}</div>'\
",
    "        f'<div style=\"font-size:22px;font-weight:700;color:{color}\">{value:.4f}</div>'\
",
    "        f'<div style=\"font-size:10px;color:#7a7974\">threshold {good_thresh}</div>'\
",
    "        '</div>'\n",
    "    )\n",
    "\n",
    "\n",
    "def comparison_table_html(df):\n",
    "    cols = ['AUC Test','Gini','KS','CV AUC','Overfit','Brier']\n",
    "    df_ = df[cols].copy()\n",
    "    rows = ''\n",
    "    for model in df_.index:\n",
    "        cells = f'<td style=\"padding:8px 14px;font-weight:600;color:#28251d\">{model}</td>'\n",
    "        for col in cols:\n",
    "            v = df_.loc[model, col]\n",
    "            is_best = (v == df_[col].max()) if col not in ['Overfit','Brier'] else (v == df_[col].min())\n",
    "            bg = '#cedcd8' if is_best else 'transparent'\n",
    "            cells += f'<td style=\"padding:8px 14px;text-align:right;background:{bg};border-radius:4px\">{v:.4f}</td>'\n",
    "        rows += f'<tr>{cells}</tr>'\n",
    "    headers = ''.join(f'<th style=\"padding:8px 14px;text-align:right;color:#7a7974;font-weight:500\">{c}</th>' for c in cols)\n",
    "    return (\n",
    "        '<table style=\"border-collapse:collapse;width:100%;font-size:13px\">'\
",
    "        f'<thead><tr><th style=\"padding:8px 14px;text-align:left;color:#7a7974;font-weight:500\">Model</th>{headers}</tr></thead>'\
",
    "        f'<tbody>{rows}</tbody></table>'\n",
    "    )\n",
    "\n",
    "\n",
    "# Collect images\n",
    "imgs = {p.stem: img_to_b64(p) for p in sorted(REPORTS.glob('*.png'))}\n",
    "\n",
    "def img_tag(key, caption=''):\n",
    "    src = imgs.get(key, '')\n",
    "    if not src:\n",
    "        return f'<p style=\"color:#bab9b4;font-style:italic\">[{key}.png not found — run notebooks 01-04 first]</p>'\n",
    "    return (\n",
    "        f'<figure style=\"margin:0 0 24px 0\">'\
",
    "        f'<img src=\"{src}\" style=\"max-width:100%;border-radius:8px;border:1px solid #dcd9d5\" loading=\"lazy\">'\
",
    "        f'<figcaption style=\"font-size:12px;color:#7a7974;margin-top:6px;text-align:center\">{caption}</figcaption>'\
",
    "        '</figure>'\n",
    "    )\n",
    "\n",
    "\n",
    "badges = (\n",
    "    metric_badge('KS',    perf['KS_test'],    0.30) +\n",
    "    metric_badge('Gini',  perf['Gini_test'],  0.40) +\n",
    "    metric_badge('AUC',   perf['AUC_test'],   0.70) +\n",
    "    metric_badge('AR',    perf['AR_test'],    0.40) +\n",
    "    metric_badge('Brier', perf['Brier_test'], 0.15, lower_better=True) +\n",
    "    metric_badge('PSI',   perf['PSI'],        0.10, lower_better=True)\n",
    ")\n",
    "\n",
    "html = f\"\"\"<!DOCTYPE html>\n",
    "<html lang=\"en\">\n",
    "<head>\n",
    "<meta charset=\"UTF-8\">\n",
    "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n",
    "<title>Credit Scoring Report — Erick Condoy</title>\n",
    "<style>\n",
    "  body{{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;\n",
    "        background:#f7f6f2;color:#28251d;margin:0;padding:0;line-height:1.6;}}\n",
    "  .header{{background:#01696f;color:#fff;padding:48px 40px;}}\n",
    "  .header h1{{margin:0 0 8px;font-size:28px;font-weight:700;}}\n",
    "  .header p{{margin:0;opacity:.85;font-size:15px;}}\n",
    "  .container{{max-width:960px;margin:0 auto;padding:40px 24px;}}\n",
    "  h2{{font-size:20px;font-weight:600;color:#01696f;border-bottom:2px solid #cedcd8;\n",
    "      padding-bottom:8px;margin:40px 0 16px;}}\n",
    "  h3{{font-size:15px;font-weight:600;color:#28251d;margin:24px 0 8px;}}\n",
    "  p{{max-width:72ch;margin:0 0 16px;font-size:14px;color:#28251d;}}\n",
    "  .badges{{margin:16px 0 24px;}}\n",
    "  .card{{background:#fff;border:1px solid #dcd9d5;border-radius:10px;\n",
    "         padding:24px;margin:16px 0;}}\n",
    "  .limitation{{background:#f9f8f5;border-left:3px solid #964219;\n",
    "               padding:10px 16px;border-radius:0 6px 6px 0;\n",
    "               font-size:13px;color:#7a7974;margin:6px 0;}}\n",
    "  .footer{{background:#1c1b19;color:#797876;text-align:center;\n",
    "           padding:24px;font-size:12px;margin-top:60px;}}\n",
    "  .footer a{{color:#4f98a3;text-decoration:none;}}\n",
    "  code{{background:#edeae5;padding:2px 6px;border-radius:4px;font-size:12px;}}\n",
    "</style>\n",
    "</head>\n",
    "<body>\n",
    "<div class=\"header\">\n",
    "  <h1>Credit Scoring — Case Study 01</h1>\n",
    "  <p>Erick Condoy &nbsp;·&nbsp; Economist (UNL) &nbsp;·&nbsp; Quant Researcher &nbsp;·&nbsp;",
    "     <a href=\"https://github.com/EryckFCS/credit-risk-lab\" style=\"color:#fff\">credit-risk-lab</a></p>\n",
    "  <p style=\"margin-top:8px;font-size:13px;opacity:.7\">Generated: {datetime.date.today()}</p>\n",
    "</div>\n",
    "<div class=\"container\">\n",
    "\n",
    "<h2>Executive Summary</h2>\n",
    "<p>A production-grade <strong>credit scorecard</strong> was built on the UCI Credit Default dataset\n",
    "(N=30,000 cardholders, Taiwan 2005). The methodology follows industry-standard practice:\n",
    "WoE binning → Logistic Regression → PDO scorecard scaling (Base=600, PDO=20). Three model\n",
    "families were benchmarked under a unified validation framework. The <strong>Logistic Regression\n",
    "Scorecard</strong> was selected as champion due to regulatory interpretability requirements\n",
    "(Basel II Pillar 2 / SR 11-7), with XGBoost retained as challenger.</p>\n",
    "\n",
    "<h2>Model Performance</h2>\n",
    "<div class=\"badges\">{badges}</div>\n",
    "\n",
    "{img_tag('11_roc_ks_cap', 'Fig 1. ROC Curve · KS Plot · CAP Curve (champion model, test set)')}\n",
    "\n",
    "<h2>Model Comparison</h2>\n",
    "<div class=\"card\">\n",
    "{comparison_table_html(comp)}\n",
    "<p style=\"margin-top:12px;color:#7a7974;font-size:12px\">\n",
    "Teal highlight = best value per metric. Overfit = AUC_train − AUC_test (lower = better).</p>\n",
    "</div>\n",
    "\n",
    "{img_tag('20_model_comparison_roc', 'Fig 2. ROC comparison and overfit analysis across all models')}\n",
    "\n",
    "<h2>SHAP Interpretability (XGBoost)</h2>\n",
    "{img_tag('21_shap_global_importance', 'Fig 3. Global feature importance — mean |SHAP value|')}\n",
    "{img_tag('22_shap_beeswarm',          'Fig 4. Beeswarm — direction and magnitude per prediction')}\n",
    "{img_tag('24_shap_waterfall_individual','Fig 5. Waterfall — individual highest-risk applicant explanation')}\n",
    "\n",
    "<h2>Scorecard Calibration</h2>\n",
    "{img_tag('12_calibration_plot',         'Fig 6. Reliability diagram — predicted PD vs observed default rate')}\n",
    "{img_tag('13_score_distribution_cutoff','Fig 7. Score distribution by class and cut-off analysis')}\n",
    "{img_tag('14_psi_score_stability',       'Fig 8. Population Stability Index (PSI)')}\n",
    "\n",
    "<h2>Regulatory Decision Matrix</h2>\n",
    "{img_tag('25_regulatory_decision_matrix','Fig 9. Champion/Challenger decision — performance vs regulatory scorecard')}\n",
    "\n",
    "<h2>Champion Model Card</h2>\n",
    "<div class=\"card\">\n",
    "  <h3>Scorecard Parameters</h3>\n",
    "  <p><code>Base Score={sc['base_score']}</code> &nbsp; <code>Base Odds={sc['base_odds']}:1</code>\n",
    "     &nbsp; <code>PDO={sc['PDO']}</code> &nbsp; <code>Factor={sc['factor']}</code>\n",
    "     &nbsp; <code>Offset={sc['offset']}</code></p>\n",
    "  <h3>Limitations</h3>\n",
    "{''.join(f'<div class=\"limitation\">{l}</div>' for l in card['limitations'])}\n",
    "</div>\n",
    "\n",
    "</div>\n",
    "<div class=\"footer\">\n",
    "  <a href=\"https://github.com/EryckFCS/credit-risk-lab\">github.com/EryckFCS/credit-risk-lab</a>\n",
    "  &nbsp;·&nbsp; Erick Condoy · {datetime.date.today().year}\n",
    "</div>\n",
    "</body></html>\n",
    "\"\"\".format(\n",
    "    badges=badges,\n",
    "    comparison_table_html=comparison_table_html(comp),\n",
    "    img_tag=img_tag,\n",
    "    sc=sc,\n",
    "    card=card,\n",
    ")\n",
    "\n",
    "out_path = REPORTS / 'credit_scoring_report.html'\n",
    "out_path.write_text(html, encoding='utf-8')\n",
    "print(f'[saved] {out_path}')\n",
    "print(f'Size  : {out_path.stat().st_size / 1024:.1f} KB  (self-contained, no external deps)')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 3. Export Notebooks via nbconvert"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Run these commands in your terminal from the notebooks/ directory:\n",
    "export_cmds = [\n",
    "    '# Install nbconvert if needed:',\n",
    "    'pip install nbconvert nbformat',\n",
    "    '',\n",
    "    '# Export individual notebooks to HTML:',\n",
    "    'jupyter nbconvert --to html --execute 01_eda_and_profiling.ipynb',\n",
    "    'jupyter nbconvert --to html --execute 02_feature_engineering_woe.ipynb',\n",
    "    'jupyter nbconvert --to html --execute 03_modeling_logistic_regression.ipynb',\n",
    "    'jupyter nbconvert --to html --execute 04_model_comparison.ipynb',\n",
    "    '',\n",
    "    '# Or run all notebooks in sequence programmatically:',\n",
    "    'for nb in 0*.ipynb; do jupyter nbconvert --to html --execute \"$nb\"; done',\n",
    "    '',\n",
    "    '# The main report (from section 2 above) is already self-contained:',\n",
    "    'ls -lh ../reports/credit_scoring_report.html',\n",
    "]\n",
    "print('\\n'.join(export_cmds))"
   ]
  },
  {
