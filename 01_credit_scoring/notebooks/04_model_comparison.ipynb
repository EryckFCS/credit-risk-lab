 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Case Study 01 — Model Comparison & Interpretability\n",
    "\n",
    "**Erick Condoy** · Economist (UNL) · Quant Researcher  \n",
    "Repository: [credit-risk-lab](https://github.com/EryckFCS/credit-risk-lab)\n",
    "\n",
    "---\n",
    "\n",
    "## Objective\n",
    "\n",
    "Compare three model families on the same validation framework and answer:\n",
    "**Is interpretability worth the predictive cost?**  \n",
    "(Regulators require explainable models — Basel II Pillar 2, SR 11-7)\n",
    "\n",
    "| Section | Content |\n",
    "|---------|---------|\n",
    "| 1 | Load Artefacts |\n",
    "| 2 | Model Zoo: LR baseline · Random Forest · XGBoost |\n",
    "| 3 | Unified Validation Dashboard |\n",
    "| 4 | SHAP Global Importance |\n",
    "| 5 | SHAP Beeswarm & Dependence Plots |\n",
    "| 6 | Individual Explanation (SHAP Waterfall) |\n",
    "| 7 | Regulatory Scorecard: Explainability vs Performance Trade-off |\n",
    "| 8 | Champion/Challenger Decision & Export |\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys, warnings, json, pickle\n",
    "from pathlib import Path\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.gridspec as gridspec\n",
    "import seaborn as sns\n",
    "from sklearn.ensemble import RandomForestClassifier, GradientBoostingClassifier\n",
    "from sklearn.linear_model import LogisticRegression\n",
    "from sklearn.pipeline import Pipeline\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "from sklearn.metrics import roc_auc_score, roc_curve, brier_score_loss\n",
    "from sklearn.model_selection import cross_val_score, StratifiedKFold\n",
    "import shap\n",
    "\n",
    "warnings.filterwarnings('ignore')\n",
    "pd.set_option('display.float_format', '{:.4f}'.format)\n",
    "\n",
    "ARTEFACTS = Path('../artefacts')\n",
    "REPORTS   = Path('../reports')\n",
    "REPORTS.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "plt.rcParams.update({\n",
    "    'figure.facecolor':'white','axes.facecolor':'white',\n",
    "    'axes.spines.top':False,'axes.spines.right':False,\n",
    "    'axes.edgecolor':'#dcd9d5','axes.labelcolor':'#28251d',\n",
    "    'xtick.color':'#7a7974','ytick.color':'#7a7974',\n",
    "    'font.family':'sans-serif','font.size':10,\n",
    "    'axes.titlesize':11,'axes.titleweight':'semibold','figure.dpi':120,\n",
    "})\n",
    "TEAL='#01696f'; MAROON='#a12c7b'; GRAY='#bab9b4'\n",
    "GREEN='#437a22'; ORANGE='#964219'; GOLD='#d19900'\n",
    "print(f'Python {sys.version}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 1. Load Artefacts from Notebook 02"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "X_train = pd.read_parquet(ARTEFACTS / 'X_train_woe.parquet')\n",
    "X_test  = pd.read_parquet(ARTEFACTS / 'X_test_woe.parquet')\n",
    "y_train = pd.read_parquet(ARTEFACTS / 'y_train.parquet').squeeze()\n",
    "y_test  = pd.read_parquet(ARTEFACTS / 'y_test.parquet').squeeze()\n",
    "\n",
    "with open(ARTEFACTS / 'selected_features.json') as f:\n",
    "    FEATURES = json.load(f)['woe_features']\n",
    "\n",
    "with open(ARTEFACTS / 'scorecard_pipeline.pkl', 'rb') as f:\n",
    "    lr_pipeline = pickle.load(f)\n",
    "\n",
    "print(f'Train: {X_train.shape}  Test: {X_test.shape}')\n",
    "print(f'Features: {len(FEATURES)}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 2. Model Zoo"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ---- Model definitions ----\n",
    "# All models trained on WoE features for fair comparison.\n",
    "# Hyperparameters are intentionally conservative (no grid search yet)\n",
    "# to illustrate baseline performance gaps before tuning.\n",
    "\n",
    "MODELS = {\n",
    "    'LR Scorecard': lr_pipeline,  # already fitted in NB03\n",
    "\n",
    "    'Random Forest': Pipeline([\n",
    "        ('rf', RandomForestClassifier(\n",
    "            n_estimators=300,\n",
    "            max_depth=6,\n",
    "            min_samples_leaf=50,      # prevents overfitting on 24k rows\n",
    "            class_weight='balanced',\n",
    "            random_state=42,\n",
    "            n_jobs=-1,\n",
    "        ))\n",
    "    ]),\n",
    "\n",
    "    'XGBoost': Pipeline([\n",
    "        ('xgb', GradientBoostingClassifier(\n",
    "            n_estimators=300,\n",
    "            learning_rate=0.05,\n",
    "            max_depth=4,\n",
    "            subsample=0.8,\n",
    "            min_samples_leaf=40,\n",
    "            random_state=42,\n",
    "        ))\n",
    "    ]),\n",
    "}\n",
    "\n",
    "# Fit unfitted models\n",
    "for name, pipe in MODELS.items():\n",
    "    step = list(pipe.named_steps.values())[0]\n",
    "    if not hasattr(step, 'classes_'):  # skip already fitted LR\n",
    "        print(f'Fitting {name}...')\n",
    "        pipe.fit(X_train[FEATURES], y_train)\n",
    "        print(f'  done.')\n",
    "print('All models ready.')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 3. Unified Validation Dashboard"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def ks_stat(y_true, y_prob):\n",
    "    df_ = pd.DataFrame({'p': y_prob, 't': y_true}).sort_values('p')\n",
    "    cb = (df_['t']==1).cumsum() / (y_true==1).sum()\n",
    "    cg = (df_['t']==0).cumsum() / (y_true==0).sum()\n",
    "    return (cb - cg).abs().max()\n",
    "\n",
    "cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\n",
    "\n",
    "results = []\n",
    "probs   = {}\n",
    "\n",
    "for name, pipe in MODELS.items():\n",
    "    y_prob_tr = pipe.predict_proba(X_train[FEATURES])[:, 1]\n",
    "    y_prob_te = pipe.predict_proba(X_test[FEATURES])[:, 1]\n",
    "    probs[name] = y_prob_te\n",
    "\n",
    "    auc_tr = roc_auc_score(y_train, y_prob_tr)\n",
    "    auc_te = roc_auc_score(y_test,  y_prob_te)\n",
    "    ks_te  = ks_stat(y_test, y_prob_te)\n",
    "    gini   = 2 * auc_te - 1\n",
    "    brier  = brier_score_loss(y_test, y_prob_te)\n",
    "    cv_auc = cross_val_score(pipe, X_train[FEATURES], y_train,\n",
    "                              cv=cv, scoring='roc_auc', n_jobs=-1).mean()\n",
    "    overfit = auc_tr - auc_te\n",
    "\n",
    "    results.append({\n",
    "        'Model':     name,\n",
    "        'AUC Train': auc_tr,\n",
    "        'AUC Test':  auc_te,\n",
    "        'CV AUC':    cv_auc,\n",
    "        'Overfit':   overfit,\n",
    "        'Gini':      gini,\n",
    "        'KS':        ks_te,\n",
    "        'Brier':     brier,\n",
    "    })\n",
    "\n",
    "res_df = pd.DataFrame(results).set_index('Model')\n",
    "\n",
    "def highlight(s):\n",
    "    if s.name in ['AUC Test', 'CV AUC', 'Gini', 'KS']:\n",
    "        return ['background-color: #cedcd8' if v == s.max() else '' for v in s]\n",
    "    elif s.name in ['Brier', 'Overfit']:\n",
    "        return ['background-color: #cedcd8' if v == s.min() else '' for v in s]\n",
    "    return ['' for _ in s]\n",
    "\n",
    "display(res_df.style.apply(highlight).format('{:.4f}'))\n",
    "print('\\n[Highlighted] best value per metric in teal.')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ---- ROC comparison plot ----\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "colors = [TEAL, GOLD, MAROON]\n",
    "\n",
    "for (name, y_prob), color in zip(probs.items(), colors):\n",
    "    fpr, tpr, _ = roc_curve(y_test, y_prob)\n",
    "    auc = roc_auc_score(y_test, y_prob)\n",
    "    gini = 2*auc - 1\n",
    "    axes[0].plot(fpr, tpr, color=color, lw=2,\n",
    "                label=f'{name}  AUC={auc:.3f} Gini={gini:.3f}')\n",
    "axes[0].plot([0,1],[0,1],'--',color=GRAY,lw=1,label='Random')\n",
    "axes[0].set_xlabel('FPR'); axes[0].set_ylabel('TPR')\n",
    "axes[0].set_title('ROC Comparison'); axes[0].legend(fontsize=9)\n",
    "\n",
    "# ---- Overfit radar (bar chart) ----\n",
    "x = np.arange(len(results))\n",
    "width = 0.25\n",
    "for i, (col, color) in enumerate([('AUC Train',TEAL),('AUC Test',GOLD),('CV AUC',GREEN)]):\n",
    "    vals = res_df[col].values\n",
    "    axes[1].bar(x + i*width, vals, width, label=col, color=color, edgecolor='none', alpha=0.85)\n",
    "axes[1].set_xticks(x + width); axes[1].set_xticklabels(res_df.index, fontsize=9)\n",
    "axes[1].set_ylim(0.5, 1.0); axes[1].set_ylabel('AUC')\n",
    "axes[1].set_title('Train / Test / CV AUC — Overfit Check'); axes[1].legend(fontsize=9)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig(REPORTS / '20_model_comparison_roc.png', bbox_inches='tight', dpi=150)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 4. SHAP Global Importance"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# SHAP on XGBoost (TreeExplainer = fast & exact for tree models)\n",
    "xgb_model = MODELS['XGBoost'].named_steps['xgb']\n",
    "explainer  = shap.TreeExplainer(xgb_model)\n",
    "X_test_vals = X_test[FEATURES].values\n",
    "shap_values = explainer.shap_values(X_test_vals)\n",
    "\n",
    "# Global bar chart — mean |SHAP|\n",
    "mean_shap = np.abs(shap_values).mean(axis=0)\n",
    "shap_df = pd.DataFrame({'feature': FEATURES, 'mean_abs_shap': mean_shap})\n",
    "shap_df = shap_df.sort_values('mean_abs_shap', ascending=True)\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(8, max(4, len(FEATURES)*0.35)))\n",
    "bars = ax.barh(shap_df['feature'], shap_df['mean_abs_shap'],\n",
    "               color=TEAL, edgecolor='none', height=0.6)\n",
    "for bar, val in zip(bars, shap_df['mean_abs_shap']):\n",
    "    ax.text(val + 0.0005, bar.get_y() + bar.get_height()/2,\n",
    "            f'{val:.4f}', va='center', fontsize=8, color='#7a7974')\n",
    "ax.set_xlabel('Mean |SHAP value| (XGBoost — test set)')\n",
    "ax.set_title('Global Feature Importance via SHAP', fontweight='bold')\n",
    "ax.set_xlim(0, shap_df['mean_abs_shap'].max() * 1.15)\n",
    "plt.tight_layout()\n",
    "plt.savefig(REPORTS / '21_shap_global_importance.png', bbox_inches='tight', dpi=150)\n",
    "plt.show()\n",
    "\n",
    "print('Top 5 features by SHAP:')\n",
    "display(shap_df.tail(5).sort_values('mean_abs_shap', ascending=False))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 5. SHAP Beeswarm & Dependence Plots"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Beeswarm — shows direction AND magnitude of each feature across all predictions\n",
    "fig, ax = plt.subplots(figsize=(9, max(5, len(FEATURES)*0.4)))\n",
    "shap.summary_plot(\n",
    "    shap_values,\n",
    "    features=X_test[FEATURES],\n",
    "    feature_names=FEATURES,\n",
    "    plot_type='dot',\n",
    "    show=False,\n",
    "    plot_size=None,\n",
    ")\n",
    "plt.gcf().set_facecolor('white')\n",
    "plt.tight_layout()\n",
    "plt.savefig(REPORTS / '22_shap_beeswarm.png', bbox_inches='tight', dpi=150)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Dependence plot — top 2 features\n",
    "top2 = shap_df.tail(2)['feature'].tolist()\n",
    "fig, axes = plt.subplots(1, 2, figsize=(13, 5))\n",
    "for i, feat in enumerate(reversed(top2)):\n",
    "    feat_idx = FEATURES.index(feat)\n",
    "    shap.dependence_plot(\n",
    "        feat_idx, shap_values, X_test[FEATURES],\n",
    "        feature_names=FEATURES,\n",
    "        ax=axes[i], show=False,\n",
    "        dot_size=6, alpha=0.4,\n",
    "    )\n",
    "    axes[i].set_facecolor('white')\n",
    "    axes[i].figure.set_facecolor('white')\n",
    "plt.tight_layout()\n",
    "plt.savefig(REPORTS / '23_shap_dependence.png', bbox_inches='tight', dpi=150)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 6. Individual Explanation — SHAP Waterfall"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Explain the highest-risk prediction in the test set\n",
    "worst_idx = np.argmax(probs['XGBoost'])\n",
    "\n",
    "explanation = shap.Explanation(\n",
    "    values=shap_values[worst_idx],\n",
    "    base_values=explainer.expected_value,\n",
    "    data=X_test[FEATURES].iloc[worst_idx].values,\n",
    "    feature_names=FEATURES,\n",
    ")\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(9, max(4, len(FEATURES)*0.35)))\n",
    "shap.waterfall_plot(explanation, show=False)\n",
    "plt.gcf().set_facecolor('white')\n",
    "plt.title(\n",
    "    f'Individual Explanation — Highest Risk Applicant\\n'\
",
    "    f'Predicted PD: {probs[\"XGBoost\"][worst_idx]:.1%} | True label: {y_test.iloc[worst_idx]}',\n",
    "    fontsize=10, pad=12\n",
    ")\n",
    "plt.tight_layout()\n",
    "plt.savefig(REPORTS / '24_shap_waterfall_individual.png', bbox_inches='tight', dpi=150)\n",
    "plt.show()\n",
    "print(f'Applicant index: {worst_idx}')\n",
    "print(f'Predicted PD   : {probs[\"XGBoost\"][worst_idx]:.4f}')\n",
    "print(f'True label     : {y_test.iloc[worst_idx]}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Regulatory Scorecard: Explainability vs Performance\n",
    "\n",
    "Basel II (Pillar 2) and SR 11-7 (FRB) require model validation teams to:\n",
    "1. Document model limitations and overfit\n",
    "2. Demonstrate that the champion model can be explained to non-technical stakeholders\n",
    "3. Justify the choice against challenger models\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "regulatory_scores = {\n",
    "    'LR Scorecard': {\n",
    "        'Interpretability'  : 5,  # fully interpretable (scorecards are whitebox)\n",
    "        'Regulatory Accept.': 5,  # standard in retail banking worldwide\n",
    "        'Ease of Monitoring' : 5,  # PSI on a single score\n",
    "        'Implementation'    : 5,  # can be coded in Excel for audit\n",
    "    },\n",
    "    'Random Forest': {\n",
    "        'Interpretability'  : 3,\n",
    "        'Regulatory Accept.': 3,  # requires model explainability addendum\n",
    "        'Ease of Monitoring' : 3,\n",
    "        'Implementation'    : 3,\n",
    "    },\n",
    "    'XGBoost': {\n",
    "        'Interpretability'  : 3,\n",
    "        'Regulatory Accept.': 3,\n",
    "        'Ease of Monitoring' : 3,\n",
    "        'Implementation'    : 3,\n",
    "    },\n",
    "}\n",
    "\n",
    "reg_df = pd.DataFrame(regulatory_scores).T\n",
    "perf_cols = ['AUC Test', 'Gini', 'KS', 'Overfit', 'Brier']\n",
    "final_df = res_df[perf_cols].join(reg_df)\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 4))\n",
    "\n",
    "# Performance heatmap\n",
    "perf_norm = res_df[perf_cols].copy()\n",
    "perf_norm['Overfit'] = 1 - perf_norm['Overfit']   # invert: lower=better\n",
    "perf_norm['Brier']   = 1 - perf_norm['Brier']\n",
    "sns.heatmap(perf_norm, annot=res_df[perf_cols].round(3), fmt='',\n",
    "            cmap='YlGn', ax=axes[0], linewidths=0.5,\n",
    "            cbar=False, annot_kws={'size':9})\n",
    "axes[0].set_title('Predictive Performance'); axes[0].tick_params(axis='x', rotation=30)\n",
    "\n",
    "# Regulatory scorecard heatmap\n",
    "sns.heatmap(reg_df, annot=True, fmt='d', cmap='YlGn',\n",
    "            ax=axes[1], linewidths=0.5, vmin=1, vmax=5,\n",
    "            cbar=False, annot_kws={'size':9})\n",
    "axes[1].set_title('Regulatory & Operational Score (1-5)')\n",
    "axes[1].tick_params(axis='x', rotation=30)\n",
    "\n",
    "plt.suptitle('Champion/Challenger Decision Matrix', fontweight='bold', y=1.02)\n",
    "plt.tight_layout()\n",
    "plt.savefig(REPORTS / '25_regulatory_decision_matrix.png', bbox_inches='tight', dpi=150)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 8. Champion/Challenger Decision & Export"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ---- Composite Score: 60% performance + 40% regulatory ----\n",
    "perf_score = perf_norm.mean(axis=1)\n",
    "reg_score  = reg_df.mean(axis=1) / 5\n",
    "composite  = 0.60 * perf_score + 0.40 * reg_score\n",
    "composite.name = 'Composite Score'\n",
    "champion = composite.idxmax()\n",
    "\n",
    "print(composite.sort_values(ascending=False).to_string())\n",
    "print(f'\\n>>> CHAMPION MODEL: {champion} <<<')\n",
    "print(f'Rationale: optimal balance of AUC/KS/Gini performance')\n",
    "print(f'          and full regulatory interpretability requirement.')\n",
    "\n",
    "# Save comparison results\n",
    "res_df.to_csv(ARTEFACTS / 'model_comparison.csv')\n",
    "\n",
    "# Save SHAP values for champion (XGBoost used for SHAP; LR is champion)\n",
    "np.save(ARTEFACTS / 'shap_values_xgb.npy', shap_values)\n",
    "\n",
    "decision = {\n",
    "    'champion' : champion,\n",
    "    'composite_scores': composite.round(4).to_dict(),\n",
    "    'rationale': (\n",
    "        f'{champion} selected as champion. '\n",
    "        'XGBoost retained as challenger model for shadow deployment. '\n",
    "        'SHAP explanations available for individual predictions when required by credit officers.'\n",
    "    )\n",
    "}\n",
    "with open(ARTEFACTS / 'champion_decision.json', 'w') as f:\n",
    "    json.dump(decision, f, indent=2)\n",
    "print('\\n[saved] champion_decision.json')\n",
    "print('[saved] model_comparison.csv')\n",
    "print('\\nNext: 05_final_report_export.ipynb — HTML report for LinkedIn')"
   ]
  }
 ]
}