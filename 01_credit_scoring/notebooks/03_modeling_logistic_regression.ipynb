    "\n",
    "# ---- CAP Curve ----\n",
    "axes[2].plot(cap_df['cum_pct_pop'], cap_df['cum_pct_bad'],\n",
    "             color=TEAL, lw=2, label=f'Model (AR={ar_te:.3f})')\n",
    "axes[2].plot([0,1],[0,1], '--', color=GRAY, lw=1, label='Random')\n",
    "dr = y_test.mean()\n",
    "axes[2].plot([0, dr, 1],[0, 1, 1], color=GREEN, lw=1.5, linestyle=':', label='Perfect')\n",
    "axes[2].set_xlabel('% Population'); axes[2].set_ylabel('% Bad Captured')\n",
    "axes[2].set_title('CAP Curve'); axes[2].legend(fontsize=9)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig(REPORTS / '11_roc_ks_cap.png', bbox_inches='tight', dpi=150)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 4. Calibration Check"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Calibration: do predicted PDs match observed default rates?\n",
    "# A well-calibrated model is required for IFRS 9 PD estimation.\n",
    "fraction_pos, mean_pred = calibration_curve(y_test, y_prob_test, n_bins=10, strategy='quantile')\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(7, 5))\n",
    "ax.plot(mean_pred, fraction_pos, 's-', color=TEAL, lw=2, markersize=7, label='Model')\n",
    "ax.plot([0,1],[0,1], '--', color=GRAY, lw=1.5, label='Perfect calibration')\n",
    "ax.fill_between(mean_pred, fraction_pos, mean_pred,\n",
    "                alpha=0.10, color=MAROON, label='Calibration gap')\n",
    "ax.set_xlabel('Mean predicted PD'); ax.set_ylabel('Observed default rate')\n",
    "ax.set_title('Calibration Plot (Reliability Diagram)', fontweight='bold')\n",
    "ax.legend(fontsize=9)\n",
    "\n",
    "brier = brier_score_loss(y_test, y_prob_test)\n",
    "ax.text(0.05, 0.90, f'Brier Score: {brier:.4f}', transform=ax.transAxes,\n",
    "        fontsize=10, color=MAROON,\n",
    "        bbox=dict(boxstyle='round,pad=0.3', facecolor='white', edgecolor='#dcd9d5'))\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig(REPORTS / '12_calibration_plot.png', bbox_inches='tight', dpi=150)\n",
    "plt.show()\n",
    "\n",
    "print(f'Brier Score: {brier:.4f}  (0=perfect, 0.25=random, lower=better)')\n",
    "print(f'Note: if calibration gap is large, apply Platt Scaling (CalibratedClassifierCV).')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Scorecard Scaling (PDO Method)\n",
    "\n",
    "Transforms log-odds → integer score in range ~300–850 (similar to FICO scale).  \n",
    "A **higher score = lower risk** (convention used by all major credit bureaus)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ---- PDO Scorecard Parameters ----\n",
    "BASE_SCORE = 600   # score at base odds\n",
    "BASE_ODDS  = 50    # good:bad ratio at base score (50:1)\n",
    "PDO        = 20    # points to double the odds\n",
    "\n",
    "FACTOR = PDO / np.log(2)\n",
    "OFFSET = BASE_SCORE - FACTOR * np.log(BASE_ODDS)\n",
    "\n",
    "print(f'Factor : {FACTOR:.4f}')\n",
    "print(f'Offset : {OFFSET:.4f}')\n",
    "\n",
    "\n",
    "def pd_to_score(pd_hat: np.ndarray, factor: float, offset: float) -> np.ndarray:\n",
    "    \"\"\"Convert predicted PD to integer scorecard score. Higher score = lower risk.\"\"\"\n",
    "    pd_hat = np.clip(pd_hat, 1e-7, 1 - 1e-7)\n",
    "    odds   = (1 - pd_hat) / pd_hat  # good:bad odds\n",
    "    score  = offset + factor * np.log(odds)\n",
    "    return np.round(score).astype(int)\n",
    "\n",
    "\n",
    "scores_train = pd_to_score(y_prob_train, FACTOR, OFFSET)\n",
    "scores_test  = pd_to_score(y_prob_test,  FACTOR, OFFSET)\n",
    "\n",
    "score_range = (scores_test.min(), scores_test.max())\n",
    "print(f'Score range (test) : {score_range[0]} – {score_range[1]}')\n",
    "print(f'Score mean (Good)  : {scores_test[y_test==0].mean():.0f}')\n",
    "print(f'Score mean (Bad)   : {scores_test[y_test==1].mean():.0f}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 6. Score Distribution & Cut-off Analysis"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "\n",
    "# ---- Score distribution by class ----\n",
    "bins = np.arange(scores_test.min()-5, scores_test.max()+10, 10)\n",
    "for label, color, name in [(0, GREEN, 'Good'), (1, MAROON, 'Bad')]:\n",
    "    axes[0].hist(scores_test[y_test==label], bins=bins, alpha=0.55,\n",
    "                color=color, label=name, density=True, edgecolor='none')\n",
    "axes[0].set_xlabel('Score'); axes[0].set_ylabel('Density')\n",
    "axes[0].set_title('Score Distribution by Default Status')\n",
    "axes[0].legend(fontsize=9)\n",
    "\n",
    "# ---- Cut-off analysis: DR and approval rate at each score threshold ----\n",
    "thresholds = np.arange(score_range[0], score_range[1], 5)\n",
    "approval_rates, default_rates_at_cutoff = [], []\n",
    "for thr in thresholds:\n",
    "    approved = y_test[scores_test >= thr]\n",
    "    approval_rates.append(len(approved) / len(y_test))\n",
    "    default_rates_at_cutoff.append(approved.mean() if len(approved) > 0 else 0)\n",
    "\n",
    "ax2 = axes[1].twinx()\n",
    "axes[1].plot(thresholds, approval_rates, color=TEAL, lw=2, label='Approval Rate')\n",
    "ax2.plot(thresholds, default_rates_at_cutoff, color=MAROON, lw=2, linestyle='--', label='Default Rate (approved)')\n",
    "axes[1].set_xlabel('Score Cut-off')\n",
    "axes[1].set_ylabel('Approval Rate', color=TEAL)\n",
    "ax2.set_ylabel('Default Rate (approved pool)', color=MAROON)\n",
    "axes[1].set_title('Cut-off Analysis: Approval Rate vs Default Rate')\n",
    "axes[1].yaxis.set_major_formatter(mticker.PercentFormatter(xmax=1))\n",
    "ax2.yaxis.set_major_formatter(mticker.PercentFormatter(xmax=1))\n",
    "lines1, labels1 = axes[1].get_legend_handles_labels()\n",
    "lines2, labels2 = ax2.get_legend_handles_labels()\n",
    "axes[1].legend(lines1+lines2, labels1+labels2, fontsize=9, loc='center right')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig(REPORTS / '13_score_distribution_cutoff.png', bbox_inches='tight', dpi=150)\n",
    "plt.show()\n",
    "\n",
    "# Recommended cut-offs table\n",
    "cutoff_df = pd.DataFrame({\n",
    "    'score_cutoff': thresholds,\n",
    "    'approval_rate': approval_rates,\n",
    "    'default_rate': default_rates_at_cutoff\n",
    "})\n",
    "target_dr = [0.05, 0.10, 0.15]\n",
    "print('Recommended cut-offs by target default rate:')\n",
    "for tdr in target_dr:\n",
    "    row = cutoff_df[cutoff_df['default_rate'] <= tdr].tail(1)\n",
    "    if not row.empty:\n",
    "        print(f'  DR ≤ {tdr:.0%}: score ≥ {int(row.score_cutoff.values[0])},'\
",
    "              f' approval={row.approval_rate.values[0]:.1%}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Population Stability Index (PSI)\n",
    "\n",
    "PSI measures whether the score distribution has shifted between train (development) and test (validation).  \n",
    "Industry thresholds: `PSI < 0.10` Stable · `0.10–0.25` Minor shift · `>0.25` Major shift → retrain required."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def psi(expected: np.ndarray, actual: np.ndarray, bins: int = 10) -> float:\n",
    "    \"\"\"Compute PSI between expected (train) and actual (test) score distributions.\"\"\"\n",
    "    breakpoints = np.percentile(expected, np.linspace(0, 100, bins + 1))\n",
    "    breakpoints = np.unique(breakpoints)\n",
    "    expected_pct = np.histogram(expected, bins=breakpoints)[0] / len(expected)\n",
    "    actual_pct   = np.histogram(actual,   bins=breakpoints)[0] / len(actual)\n",
    "    # Avoid log(0)\n",
    "    expected_pct = np.where(expected_pct == 0, 1e-4, expected_pct)\n",
    "    actual_pct   = np.where(actual_pct   == 0, 1e-4, actual_pct)\n",
    "    psi_bins = (actual_pct - expected_pct) * np.log(actual_pct / expected_pct)\n",
    "    return psi_bins.sum(), pd.DataFrame({\n",
    "        'bin': range(1, len(psi_bins)+1),\n",
    "        'expected_pct': expected_pct,\n",
    "        'actual_pct': actual_pct,\n",
    "        'psi_bin': psi_bins\n",
    "    })\n",
    "\n",
    "\n",
    "psi_val, psi_detail = psi(scores_train, scores_test)\n",
    "\n",
    "status = 'Stable ✅' if psi_val < 0.10 else ('Minor shift ⚠️' if psi_val < 0.25 else 'Major shift 🚨')\n",
    "print(f'PSI = {psi_val:.4f}  →  {status}')\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(13, 4))\n",
    "axes[0].bar(psi_detail['bin']-0.2, psi_detail['expected_pct'], 0.4,\n",
    "            color=TEAL,   label='Train (expected)', edgecolor='none')\n",
    "axes[0].bar(psi_detail['bin']+0.2, psi_detail['actual_pct'],   0.4,\n",
    "            color=ORANGE, label='Test (actual)',    edgecolor='none')\n",
    "axes[0].set_xlabel('Score Bin'); axes[0].set_ylabel('% Population')\n",
    "axes[0].set_title('PSI: Score Distribution Shift'); axes[0].legend(fontsize=9)\n",
    "axes[1].bar(psi_detail['bin'], psi_detail['psi_bin'], color=MAROON, edgecolor='none')\n",
    "axes[1].axhline(0.10/len(psi_detail), color=GRAY, linestyle='--', lw=1.2, label='Threshold per bin')\n",
    "axes[1].set_xlabel('Score Bin'); axes[1].set_ylabel('PSI contribution')\n",
    "axes[1].set_title(f'PSI by Bin  (Total PSI={psi_val:.4f} — {status})')\n",
    "axes[1].legend(fontsize=9)\n",
    "plt.tight_layout()\n",
    "plt.savefig(REPORTS / '14_psi_score_stability.png', bbox_inches='tight', dpi=150)\n",
    "plt.show()"
   ]
  },
